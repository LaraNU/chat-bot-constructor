# Copy this file to .env.local (for local development) or .env.test (for running tests)
# and fill in real values. Never commit .env, .env.local, .env.test — they are gitignored.

# Параметры для Prisma (работа с БД)
# Pooled connection used by Prisma at runtime (pgbouncer, port 6543)
DATABASE_URL="postgresql://<user>:<password>@<host>:6543/postgres?pgbouncer=true"
# Direct connection used by Prisma for migrations (port 5432)
DIRECT_URL="postgresql://<user>:<password>@<host>:5432/postgres"

# Параметры для Supabase Client (Auth, Storage, Realtime)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# Public base URL used to build the Telegram webhook URL when publishing a bot.
# Falls back to `https://${VERCEL_URL}` when unset (e.g. on Vercel Preview deployments).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-only master key used to deterministically derive each bot's Telegram
# webhook secret via HMAC-SHA256(botId, TELEGRAM_WEBHOOK_SECRET_KEY).
# One value for the whole app — NOT a per-bot Telegram bot token.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET_KEY="replace-with-a-random-64-char-hex-string"

# Credentials used by the Playwright authentication setup (e2e tests only)
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=change-me

# Enables the Next.js bundle analyzer (npm run analyze). Optional, defaults to false.
ANALYZE=false
