generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Модель Бота
model Bot {
  id        String   @id @default(uuid())
  name      String
  userId    String
  token     String?
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  flow      Flow?

  sessions  UserSession[]

  @@index([userId])
}

// Модель Потока (черновик)
model Flow {
  id        String   @id @default(uuid())

  /// [WorkflowNodes]
  nodes     Json     // Массив узлов React Flow

  /// [WorkflowEdges]
  edges     Json     // Массив связей React Flow

  updatedAt DateTime @default(now()) @updatedAt

  botId     String   @unique // Ссылка на бота
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)

  snapshot  FlowSnapshot?
}

// Опубликованный снимок потока
// Создаётся/обновляется только при Publish, webhook читает отсюда.
// Черновик (Flow) и снимок хранятся раздельно — изменения черновика
// не влияют на работающего бота до следующей публикации.
model FlowSnapshot {
  id        String   @id @default(uuid())

  /// [WorkflowNodes]
  nodes     Json

  /// [WorkflowEdges]
  edges     Json

  createdAt DateTime @default(now())

  flowId    String   @unique
  flow      Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
}

// Модель Сессии
model UserSession {
  id            String   @id @default(uuid())
  telegramChatId String  // ID чата в Telegram
  currentNodeId String?  // ID узла, на котором сейчас стоит пользователь
  variables     Json?

  // Telegram `update_id` последнего успешно обработанного апдейта для этого чата.
  // Используется для идемпотентности: Telegram повторяет доставку апдейта, если
  // webhook не ответил 200 OK вовремя, а update_id монотонно возрастает в рамках
  // одного бота, поэтому хранить достаточно только последнее значение (см. #61).
  lastUpdateId  Int?

  botId         String
  bot           Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  
  tempData       Json     @default("{}") 
  createdAt      DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([botId, telegramChatId])
}

// Универсальная таблица ответов для ВСЕХ ботов в системе
model BotResponse {
  id             String   @id @default(uuid())
  botId          String
  telegramChatId String
  createdAt      DateTime @default(now())

  answers        Json
  
  @@index([botId, telegramChatId])
}
