#!/bin/sh
COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# 1. Если сообщение начинается со слова Merge/merge, пропускаем все проверки
if echo "$COMMIT_MSG" | grep -iq "^merge"; then
  echo "ℹ️ Merge commit detected. Skipping format check."
  exit 0
fi

# 2. Получаем название текущей ветки
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)

# 3. Извлекаем номер задачи из ветки (только цифры)
BRANCH_NUMBER=$(echo "$BRANCH_NAME" | grep -o '[0-9]\+' | head -n 1)

# 4. ЕСЛИ В НАЗВАНИИ ВЕТКИ НЕТ НОМЕРА — ПРОПУСКАЕМ ВСЕ ПРОВЕРКИ
if [ -z "$BRANCH_NUMBER" ]; then
  echo "ℹ️ No task number found in branch name ($BRANCH_NAME). Skipping format check."
  exit 0
fi

# 5. ЕСЛИ НОМЕР ЕСТЬ — ВКЛЮЧАЕТСЯ СТРОГАЯ ВАЛИДАЦИЯ

# Проверяем базовый префикс (feat:, fix: и т.д.)
if ! echo "$COMMIT_MSG" | grep -Eq "^(feat|fix|refactor|docs|chore|test):"; then
  echo "--------------------------------------------------------"
  echo "❌ ERROR: Invalid commit message prefix."
  echo "Expected starts with: feat:, fix:, docs:, refactor:, chore:, test:"
  echo "--------------------------------------------------------"
  exit 1
fi

# Если в сообщении ЕЩЕ НЕТ этого номера задачи, добавляем его
if ! echo "$COMMIT_MSG" | grep -q "$BRANCH_NUMBER"; then
  # Модифицируем строку, учитывая возможные пробелы после двоеточия
  MODIFIED_MSG=$(echo "$COMMIT_MSG" | sed -E "s/^([a-z]+):[[:space:]]*/\1: $BRANCH_NUMBER - /")
  echo "$MODIFIED_MSG" > "$COMMIT_MSG_FILE"
  COMMIT_MSG=$MODIFIED_MSG
fi

# Финальная валидация строгого формата
COMMIT_REGEX="^(feat|fix|refactor|docs|chore|test): $BRANCH_NUMBER - .+$"
if ! echo "$COMMIT_MSG" | grep -Eq "$COMMIT_REGEX"; then
  echo "--------------------------------------------------------"
  echo "❌ ERROR: Invalid commit message format after modification."
  echo "Expected: <type>: $BRANCH_NUMBER - <description>"
  echo "Example: docs: $BRANCH_NUMBER - update readme"
  echo "--------------------------------------------------------"
  exit 1
fi

echo "✅ Commit message style is valid for task $BRANCH_NUMBER!"
